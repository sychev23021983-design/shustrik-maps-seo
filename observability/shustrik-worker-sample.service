[Unit]
Description=Shustrik aggregate Apache worker and resource sample
After=docker.service
[Service]
Type=oneshot
User=vpsadmin
Group=vpsadmin
ExecStart=/usr/bin/python3 /opt/vps/shustrik-observability/sample.py
TimeoutStartSec=12
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/shustrik-observability
